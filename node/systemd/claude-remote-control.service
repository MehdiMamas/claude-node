[Unit]
Description=Claude Code Remote Control (claude-node)
Documentation=https://github.com/MehdiMamas/claude-node
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/rc
ExecStart=%h/.local/bin/claude remote-control --spawn same-dir --permission-mode bypassPermissions
Restart=always
# The status screen redraws about once a second with no terminal; keep it
# out of the journal and log only errors.
StandardOutput=null
StandardError=journal
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=120
KillMode=mixed
TimeoutStopSec=30
MemoryHigh=60%
MemoryMax=75%

[Install]
WantedBy=default.target
